{
	"name": "puzzle-league",
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"test:unit:coverage": "vitest run --coverage",
		"test:unit:watch": "vitest",
		"test": "pnpm test:unit && pnpm test:e2e",
		"loadtest": "tsx loadtest/run.ts",
		"loadtest:teardown": "tsx loadtest/teardown.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"release": "commit-and-tag-version --skip.tag",
		"release:dry": "commit-and-tag-version --skip.tag --dry-run",
		"postinstall": "svelte-kit sync && prisma generate"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@inquirer/prompts": "^8.4.3",
		"@internationalized/date": "^3.11.0",
		"@playwright/test": "^1.58.2",
		"@skeletonlabs/skeleton": "^4.12.1",
		"@skeletonlabs/skeleton-svelte": "^4.12.1",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/enhanced-img": "^0.10.3",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^22.19.12",
		"@types/pg": "^8.20.0",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^4.1.8",
		"autoprefixer": "^10.4.27",
		"better-auth": "^1.6.11",
		"bits-ui": "^2.16.2",
		"cloudinary": "^2.9.0",
		"commit-and-tag-version": "^12.7.3",
		"dotenv": "^16.6.1",
		"jsdom": "^29.0.0",
		"pg": "^8.20.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.3",
		"sveltekit-i18n": "^2.4.2",
		"sveltekit-superforms": "^2.30.0",
		"ts-node": "^10.9.2",
		"tsx": "^4.22.4",
		"typescript": "^5.9.3",
		"vite": "8.3.0",
		"vitest": "^4.1.0",
		"vitest-mock-extended": "^4.0.0"
	},
	"dependencies": {
		"@iconify-svelte/mdi": "^1.0.0",
		"@iconify/svelte": "^5.2.1",
		"@prisma/adapter-pg": "^7.4.1",
		"@prisma/client": "^7.8.0",
		"@prisma/extension-accelerate": "^3.0.1",
		"@prisma/sqlcommenter-query-insights": "^7.8.0",
		"@upstash/qstash": "^2.10.1",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.0",
		"@vercel/analytics": "^1.6.1",
		"@vercel/speed-insights": "^1.3.1",
		"ably": "^2.21.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"posthog-js": "^1.374.3",
		"posthog-node": "^5.34.8",
		"prisma": "^7.8.0",
		"qrcode": "^1.5.4",
		"resend": "^6.12.2",
		"tailwindcss": "^4.2.1",
		"zod": "^4.3.6"
	}
}
