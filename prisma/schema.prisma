generator client {
  provider = "prisma-client"
  output   = "../src/lib/.prisma/generated/prisma"
}

generator zod {
  provider          = "zod-prisma-types"
  output            = "../src/lib/.prisma/generated/zod"
  useMultipleFiles  = true
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?
  country         String?
  postalCode      String?
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  records         Record[]          @relation("RecordParticipants")
  createdRecords  Record[]          @relation("RecordCreator")
  roleAssignments RoleAssignment[]
  requests        Request[]
  leaguePoints    LeaguePoints[]
  competitions    Competition[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum CategoryType {
  INDIVIDUAL
  PAIRS
  TEAM
  JUNIOR_INDIVIDUAL
  JUNIOR_PAIRS
  PUZZLE_CHESS
  OTHER
}

enum CompetitionStatus {
  NOT_STARTED
  STARTED
  FINISHED
  CANCELLED
}

enum Role {
  PARTICIPANT
  ORGANIZER
  JUDGE
  ADMIN

  @@map("UserRole")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InscriptionStatus {
  PENDING
  ACCEPTED
  REFUSED
}

model League {
  id           String         @id @default(cuid())
  name         String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  competitions Competition[]
  leaguePoints LeaguePoints[]

  @@map("league")
}

model Competition {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  location         String?
  country          String?
  postalCode       String?
  image_cld_id     String?
  startDate        DateTime
  endDate          DateTime
  status           CompetitionStatus @default(NOT_STARTED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  leagueId         String?
  league           League?           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  categories       Category[]
  roleAssignments  RoleAssignment[]
  requests         Request[]
  creatorId        String
  creator          User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  registrationOpen Boolean           @default(false)

  @@map("competition")
}

model Puzzle {
  id           String     @id @default(cuid())
  name         String?
  pieces       Int
  image_cld_id String?
  brand        String
  serialNumber String?
  barcode      String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  categories   Category[]

  @@map("puzzle")
}

model Category {
  id            Int          @id @default(autoincrement())
  description   String
  subname       String?
  type          CategoryType
  maxPartySize  Int?
  startTime     DateTime
  endTime       DateTime
  realStartTime DateTime?
  realEndTime   DateTime?
  status        String       @default("not_started") // not_started, in_progress, completed
  maxParties    Int?
  competitionId Int
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  records       Record[]
  puzzles       Puzzle[]

  @@map("category")
}

model Record {
  id          String            @id @default(cuid())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  finishTime  DateTime?
  tableNumber Int?
  status      InscriptionStatus @default(PENDING)
  categoryId  Int
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users       User[]            @relation("RecordParticipants")
  creatorId   String
  creator     User              @relation("RecordCreator", fields: [creatorId], references: [id], onDelete: SetDefault)

  @@map("record")
}

model RoleAssignment {
  id            String       @id @default(cuid())
  role          Role
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId Int?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, role])
  @@map("role_assignment")
}

model Request {
  id             String        @id @default(cuid())
  role           Role
  status         RequestStatus @default(PENDING)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId  Int?
  competition    Competition?  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reason         String?
  additionalInfo String?

  @@map("request")
}

model LeaguePoints {
  id          String @id @default(cuid())
  totalPoints Int    @default(0)
  league      League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId    String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@unique([userId, leagueId])
  @@map("league_points")
}
