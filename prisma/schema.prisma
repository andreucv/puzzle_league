generator client {
  provider = "prisma-client"
  output   = "../src/lib/.prisma/generated/prisma"
}

generator zod {
  provider         = "zod-prisma-types"
  output           = "../src/lib/.prisma/generated/zod"
  useMultipleFiles = true
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                 String                                 @id
  name                               String
  email                              String
  emailVerified                      Boolean
  image                              String?
  country                            String?
  postalCode                         String?
  locationPromptLastChecked          DateTime?
  phonePrefix                        String?
  phoneNumber                        String?
  phonePromptLastChecked             DateTime?
  locale                             String?
  localePromptLastChecked            DateTime?
  externalParticipantsLastChecked    DateTime?
  emailVerificationPromptLastChecked DateTime?
  publicProfileVisibility            Boolean                                @default(false)
  publicResultsVisibility            Boolean                                @default(true)
  createdAt                          DateTime
  updatedAt                          DateTime
  sessions                           Session[]
  accounts                           Account[]
  entries                            Entry[]                                @relation("EntryParticipants")
  createdEntries                     Entry[]                                @relation("EntryCreator")
  roleAssignments                    RoleAssignment[]
  coorganizerAssignments             CompetitionCoorganizerRoleAssignment[]
  requests                           Request[]
  leaguePoints                       LeaguePoints[]
  competitions                       Competition[]
  notifications                      Notification[]                         @relation("NotificationRecipient")
  createdExternalParticipants        ExternalParticipant[]                  @relation("ExternalParticipantCreator")
  claimedExternalParticipants        ExternalParticipant[]                  @relation("ExternalParticipantClaimer")
  categoryJudgeAssignments           CategoryJudgeAssignment[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

enum CategoryType {
  INDIVIDUAL
  PAIRS
  TEAM
  JUNIOR_INDIVIDUAL
  JUNIOR_PAIRS
  PUZZLE_CHESS
  OTHER
}

enum CategoryStatus {
  NOT_STARTED
  LIVE
  STOPPED
  COMPLETE
  CANCELED
}

enum CompetitionStatus {
  NOT_STARTED
  STARTED
  FINISHED
  CANCELLED
}

enum Role {
  PARTICIPANT
  ORGANIZER
  JUDGE
  ADMIN

  @@map("UserRole")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  WAITLISTED
}

enum NotificationType {
  REGISTRATION_CREATED
  REGISTRATION_CONFIRMED
  REGISTRATION_REFUSED
  REGISTRATION_WAITLISTED
  REGISTRATION_PROMOTED
  COMPETITION_STARTED
  COMPETITION_CANCELLED
  ROLE_REQUEST_APPROVED
  ROLE_REQUEST_REJECTED
  AUTO_STOP_SUCCESS
  AUTO_STOP_FAILED
  EXTERNAL_PARTICIPANT_CLAIMED
  TABLE_ASSIGNED
  PAYMENT_REMINDER
  TAG_REJECTED
  GENERAL
}

enum EntryTagStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ParticipantTagType {
  LOCAL_MUNICIPALITY
  JUVENILE
}

model League {
  id           String         @id @default(cuid())
  name         String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  competitions Competition[]
  leaguePoints LeaguePoints[]

  @@map("league")
}

model Competition {
  id                     Int                                    @id @default(autoincrement())
  name                   String
  description            String?
  location               String?
  country                String?
  postalCode             String?
  image_cld_id           String?
  startDate              DateTime
  endDate                DateTime
  status                 CompetitionStatus                      @default(NOT_STARTED)
  createdAt              DateTime                               @default(now())
  updatedAt              DateTime                               @updatedAt
  leagueId               String?
  league                 League?                                @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  categories             Category[]
  coorganizerAssignments CompetitionCoorganizerRoleAssignment[]
  requests               Request[]
  paymentMethod          String?
  creatorId              String
  creator                User                                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  registrationOpen       Boolean                                @default(false)
  showPaymentWarning     Boolean                                @default(false)

  @@map("competition")
}

model Puzzle {
  id           String     @id @default(cuid())
  name         String?
  pieces       Int
  image_cld_id String?
  brand        String
  serialNumber String?
  barcode      String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  categories   Category[]

  @@map("puzzle")
}

model Category {
  id                Int                       @id @default(autoincrement())
  description       String
  subname           String?
  type              CategoryType
  maxPartySize      Int?
  startTime         DateTime
  endTime           DateTime
  realStartTime     DateTime?
  realEndTime       DateTime?
  extraMinutes      Int                       @default(0)
  status            CategoryStatus            @default(NOT_STARTED)
  autoStopMessageId String?
  maxParties        Int?
  price             Int                       @default(0)
  competitionId     Int
  competition       Competition               @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  entries           Entry[]
  puzzles           Puzzle[]
  judgeAssignments  CategoryJudgeAssignment[]
  tagCategories     TagCategory[]

  @@map("category")
}

model Entry {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  confirmedAt          DateTime?
  lastRemindedAt       DateTime?
  finishTime           DateTime?
  tableNumber          Int?
  nPiecesCompleted     Int?
  status               RegistrationStatus    @default(PENDING_CONFIRMATION)
  categoryId           Int
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users                User[]                @relation("EntryParticipants")
  externalParticipants ExternalParticipant[] @relation("EntryExternalParticipants")
  creatorId            String
  creator              User                  @relation("EntryCreator", fields: [creatorId], references: [id], onDelete: SetDefault)
  entryTag             EntryTag?

  @@map("entry")
}

model TagCategory {
  id            String             @id @default(cuid())
  tag           ParticipantTagType
  categoryId    Int
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priceOverride Int?

  @@unique([tag, categoryId])
  @@map("tag_category")
}

model EntryTag {
  id        String             @id @default(cuid())
  entryId   String
  entry     Entry              @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag       ParticipantTagType
  status    EntryTagStatus     @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([entryId])
  @@map("entry_tag")
}

model ExternalParticipant {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("ExternalParticipantCreator", fields: [createdById], references: [id], onDelete: Cascade)
  claimedById String?
  claimedBy   User?    @relation("ExternalParticipantClaimer", fields: [claimedById], references: [id], onDelete: SetNull)
  entries     Entry[]  @relation("EntryExternalParticipants")

  @@map("external_participant")
}

model RoleAssignment {
  id        String   @id @default(cuid())
  role      Role
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, role])
  @@map("role_assignment")
}

model CompetitionCoorganizerRoleAssignment {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId Int
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, competitionId])
  @@map("competition_coorganizer_role_assignment")
}

model CategoryJudgeAssignment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
  @@map("category_judge_assignment")
}

model Request {
  id             String        @id @default(cuid())
  role           Role
  status         RequestStatus @default(PENDING)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId  Int?
  competition    Competition?  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reason         String?
  additionalInfo String?

  @@map("request")
}

model LeaguePoints {
  id          String @id @default(cuid())
  totalPoints Int    @default(0)
  league      League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId    String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@unique([userId, leagueId])
  @@map("league_points")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  data      Json?
  read      Boolean          @default(false)
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?

  @@map("jwks")
}

model LandingStats {
  id               Int      @id @default(1)
  upcomingCount    Int      @default(0)
  cityCount        Int      @default(0)
  participantCount Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@map("landing_stats")
}
