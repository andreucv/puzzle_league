<script lang="ts">
    import type { PageData } from './$types';

    let { data }: { data: PageData } = $props();

    // Debug: log competitions data
    $effect(() => {
        console.log('Competitions data:', data.competitions);
        console.log('Number of competitions:', data.competitions?.length || 0);
        console.log('Current month/year:', currentMonth, currentYear);
        console.log('Calendar days length:', calendarDays.length);
    });

    // Reactive state for calendar
    let currentMonth = $state(new Date().getMonth());
    let currentYear = $state(new Date().getFullYear());
    let calendarDays = $state<Array<{date: Date, competitions: any[], isCurrentMonth: boolean, isToday: boolean}>>([]);

    const monthNames = [
        'January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'
    ];

    const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    // Calendar navigation functions
    function previousMonth() {
        if (currentMonth === 0) {
            currentMonth = 11;
            currentYear--;
        } else {
            currentMonth--;
        }
    }

    function nextMonth() {
        if (currentMonth === 11) {
            currentMonth = 0;
            currentYear++;
        } else {
            currentMonth++;
        }
    }

    function goToToday() {
        const today = new Date();
        currentMonth = today.getMonth();
        currentYear = today.getFullYear();
    }

    // Reactive calendar generation
    $effect(() => {
        console.log('Generating calendar for:', monthNames[currentMonth], currentYear);

        const firstDay = new Date(currentYear, currentMonth, 1);
        const startDate = new Date(firstDay);
        startDate.setDate(startDate.getDate() - firstDay.getDay());

        const newCalendarDays = [];
        const today = new Date();

        for (let i = 0; i < 42; i++) {
            const date = new Date(startDate);
            date.setDate(startDate.getDate() + i);

            const dayCompetitions = (data?.competitions || []).filter(comp => {
                if (!comp?.startDate) return false;
                try {
                    const compDate = new Date(comp.startDate);
                    return compDate.toDateString() === date.toDateString();
                } catch (e) {
                    console.error('Error parsing date:', comp.startDate, e);
                    return false;
                }
            });

            newCalendarDays.push({
                date,
                competitions: dayCompetitions,
                isCurrentMonth: date.getMonth() === currentMonth,
                isToday: date.toDateString() === today.toDateString()
            });
        }

        console.log('Generated calendar days:', newCalendarDays.length);
        calendarDays = newCalendarDays;
    });

    // Helper function to get weeks from calendar days
    function getCalendarWeeks() {
        const weeks = [];
        for (let i = 0; i < calendarDays.length; i += 7) {
            weeks.push(calendarDays.slice(i, i + 7));
        }
        return weeks;
    }
</script>

<div class="container mx-auto p-6">
    <!-- Page Title -->
    <h4 class="h4 text-center mb-6">Competition Calendar</h4>

    <!-- Calendar Navigation -->
    <div class="flex justify-between items-center mb-6">
        <button
            class="btn variant-filled-primary"
            onclick={previousMonth}
            type="button"
        >
            ← Previous
        </button>

        <div class="text-center">
            <h2 class="h2 font-bold">
                {monthNames[currentMonth]} {currentYear}
            </h2>
            <button
                class="btn btn-sm variant-ghost-surface mt-2"
                onclick={goToToday}
                type="button"
            >
                Go to Today
            </button>
        </div>

        <button
            class="btn variant-filled-primary"
            onclick={nextMonth}
            type="button"
        >
            Next →
        </button>
    </div>

    <!-- Calendar Table -->
    <div class="card">
        <div class="table-container">
            <table class="table table-hover">
                <thead>
                    <tr>
                        {#each dayNames as dayName}
                            <th class="text-center font-bold p-4 bg-surface-200-700">{dayName}</th>
                        {/each}
                    </tr>
                </thead>
                <tbody>
                    {#if calendarDays.length > 0}
                        {#each getCalendarWeeks() as week, weekIndex}
                            <tr>
                                {#each week as day, dayIndex}
                                    <td class="p-0 border border-surface-300-600 h-32 w-auto
                                        {!day.isCurrentMonth ? 'bg-surface-100-800 opacity-50' : 'bg-surface-50-950'}
                                        {day.isToday ? 'bg-primary-100 dark:bg-primary-900' : ''}">

                                        <div class="h-full p-2 relative">
                                            <!-- Date Number -->
                                            <div class="flex justify-between items-start mb-1">
                                                <span class="font-semibold text-sm
                                                    {day.isToday ? 'text-primary-600 dark:text-primary-400' : ''}
                                                    {!day.isCurrentMonth ? 'text-surface-400' : 'text-surface-900 dark:text-surface-100'}">
                                                    {day.date.getDate()}
                                                </span>

                                                <!-- Competition Indicator -->
                                                {#if day.competitions.length > 0}
                                                    <div class="flex items-center gap-1">
                                                        <span class="badge variant-filled-warning text-xs">
                                                            {day.competitions.length}
                                                        </span>
                                                        <div class="w-2 h-2 bg-warning-500 rounded-full"></div>
                                                    </div>
                                                {/if}
                                            </div>

                                            <!-- Competition Names -->
                                            {#if day.competitions.length > 0}
                                                <div class="mt-1 space-y-1">
                                                    {#each day.competitions.slice(0, 2) as competition}
                                                        <a
                                                            href="/competitions/competition_details/{competition.id}"
                                                            class="block text-xs bg-primary-100 dark:bg-primary-900 text-primary-800 dark:text-primary-200 px-1 py-0.5 rounded truncate hover:bg-primary-200 dark:hover:bg-primary-800 transition-colors"
                                                            title={competition.name}
                                                        >
                                                            {competition.name}
                                                        </a>
                                                    {/each}
                                                    {#if day.competitions.length > 2}
                                                        <div class="text-xs text-surface-500 text-center">
                                                            +{day.competitions.length - 2} more
                                                        </div>
                                                    {/if}
                                                </div>
                                            {/if}

                                            <!-- Today Indicator -->
                                            {#if day.isToday}
                                                <div class="absolute top-1 right-1">
                                                    <div class="w-2 h-2 bg-primary-500 rounded-full"></div>
                                                </div>
                                            {/if}
                                        </div>
                                    </td>
                                {/each}
                            </tr>
                        {/each}
                    {:else}
                        <!-- Loading state or fallback -->
                        <tr>
                            <td colspan="7" class="text-center p-8">
                                <div class="text-surface-500">
                                    Loading calendar...
                                </div>
                            </td>
                        </tr>
                    {/if}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Legend -->
    <div class="flex justify-center gap-6 mt-4 text-sm">
        <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-primary-500 rounded-full"></div>
            <span>Today</span>
        </div>
        <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-warning-500 rounded-full"></div>
            <span>Has Competitions</span>
        </div>
        <div class="flex items-center gap-2">
            <div class="badge variant-filled-warning text-xs">3</div>
            <span>Number of Competitions</span>
        </div>
    </div>
</div>
